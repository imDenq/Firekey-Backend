# Debug et environnement
DEBUG=False
ENVIRONMENT=development

# Utilisez : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change_this_to_a_secure_key

# Base de données PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Pour AES_SECRET_KEY : python -c "import os; print(os.urandom(32))"
# Pour TEMP_FILE_ENCRYPTION_KEY : python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_SECRET_KEY=
TEMP_FILE_ENCRYPTION_KEY=

# JWT Configuration (en secondes)
JWT_ACCESS_TOKEN_LIFETIME=86400
JWT_REFRESH_TOKEN_LIFETIME=86400

# Sécurité - Hosts autorisés (séparez par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - En production, spécifiez les domaines autorisés
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Taille maximale des fichiers (en bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# E2E Encryption
E2E_ENCRYPTION_ENABLED=True
E2E_MIGRATION_MODE=True
E2E_MIGRATION_TOKEN_LIFETIME=3600

# Configuration de logging
LOG_LEVEL=INFO
